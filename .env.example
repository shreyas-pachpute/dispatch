# Optional. Model settings normally come from the UI (kept in the visitor's browser, sent as headers);
# set a server default here only for a private deployment.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Postgres. Leave unset for SQLite in data/runtime (local development only).
# Use a direct connection string, not a pooler (PgBouncer) endpoint: the API sets search_path per session.
# Neon on Vercel exposes it as DATABASE_URL_UNPOOLED, which is preferred when present.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
