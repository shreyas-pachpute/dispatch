# Optional. You can also set the provider, model and key from the control room's settings panel;
# keys entered there stay in the API process's memory and are never written to disk.

# Anthropic (default when set): Opus 5 for judgment, Sonnet 5 for volume
ANTHROPIC_API_KEY=

# Or any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Where the SQLite file and logs live
# DISPATCH_DB=data/runtime/dispatch.sqlite
